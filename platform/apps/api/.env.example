# Copier en .env (ignoré par Git) : cp .env.example .env
NODE_ENV=development
PORT=3000

# Redis et Postgres du docker-compose de développement (infra/docker-compose.yml)
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://toctoc:toctoc@localhost:5433/toctoc

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# Secret de signature des jetons JWT (32 caractères minimum). Obligatoire en production.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Envoi des codes OTP : 'console' écrit le code dans les logs (en attendant WhatsApp)
OTP_DELIVERY=console
# Indicatif ajouté aux numéros saisis sans préfixe (224 = Guinée)
DEFAULT_COUNTRY_CODE=224

# true seulement si l'API est derrière un reverse proxy (Caddy) : l'IP du client est lue dans
# X-Forwarded-For. En local, sans proxy, laisser false (l'en-tête serait falsifiable).
TRUST_PROXY=false

# Opérateur de mobile money : 'fake' = aucun paiement réel, on simule les webhooks (voir README).
PAYMENT_PROVIDER=fake
# Secret de signature des webhooks de paiement (32 caractères minimum). Obligatoire en production.
PAYMENT_WEBHOOK_SECRET=

# Envoi du récap au partenaire à la clôture : 'console' l'écrit dans les logs, l'équipe le transmet
# à la main (en attendant WhatsApp / SMS).
PARTNER_NOTIFICATION=console
